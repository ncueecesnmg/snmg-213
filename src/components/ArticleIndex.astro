---
import Layout from '../layouts/Layout.astro';
import { getPosts, categories, formatDate } from '../lib/content.mjs';
import { withBase } from '../lib/paths.mjs';
interface Props { tutorials?: boolean; }
const { tutorials = false } = Astro.props;
const title = tutorials ? '教學文章' : '最新公告';
const description = tutorials ? '無線網路連線、系所郵件設定與服務使用教學。' : '維護通知、服務異動與機房活動。';
const path = tutorials ? '/tutorials/' : '/announcements/';
const posts = getPosts().filter(post => (post.category === '教學文件') === tutorials);
const filters = tutorials ? [] : categories.filter(category => category !== '教學文件');
---
<Layout title={title}>
  <header class="page-intro wrap"><a class="back-link" href={withBase('/')}>首頁</a><h1>{title}</h1><p>{description}</p></header>
  <section class="page-content wrap" aria-label="文章列表">
    <div class="filters">
      <nav class="filter-tabs" aria-label="文章分類">{['', ...filters].map(category => <a href={withBase(`${path}?${new URLSearchParams(category ? { category } : {})}`)} data-category={category} aria-current={category === '' ? 'true' : undefined}>{category || '全部內容'}</a>)}</nav>
      <form class="search-form" method="get" action={withBase(path)}><label class="visually-hidden" for="search">搜尋文章</label><input id="search" name="q" type="search" placeholder="搜尋文章或關鍵字" maxlength="100" /><button type="submit">搜尋</button></form>
    </div>
    <p id="result-count" role="status" style="margin-bottom:20px;color:var(--muted);font-size:14px">共 {posts.length} 篇內容</p>
    <noscript><p style="margin-bottom:20px">目前顯示全部文章；啟用 JavaScript 後可使用搜尋與分類。</p></noscript>
    <div class="article-list">{posts.map(post => <a class="article-item" href={withBase(`/announcements/${post.slug}/`)} data-category={post.category} data-search={`${post.title} ${post.summary}`.toLowerCase()}><div class="news-meta"><span>{post.pinned ? '置頂・' : ''}{post.category}</span><time datetime={post.date}>{formatDate(post.date)}{post.source && post.sourceType !== 'full' ? ' 匯入' : ''}</time></div><div><h2>{post.title}</h2><p>{post.summary}</p></div><span aria-hidden="true">↗</span></a>)}</div>
    <div class="empty-state" id="empty-state" hidden><h2>沒有找到相關內容</h2><p>試試其他關鍵字，或瀏覽全部文章。</p><a class="button" id="clear-filters" href={withBase(path)}>清除篩選</a></div>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#search')!;
    const rows = [...document.querySelectorAll<HTMLElement>('.article-item')];
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.filter-tabs a')];
    function applyFilters() {
      const params = new URLSearchParams(location.search);
      const query = (params.get('q') || '').trim().slice(0, 100);
      const category = params.get('category') || '';
      search.value = query;
      let count = 0;
      rows.forEach(row => {
        const matches = (!category || row.dataset.category === category) && (row.dataset.search || '').includes(query.toLowerCase());
        row.hidden = !matches;
        if (matches) count++;
      });
      tabs.forEach(tab => { if (tab.dataset.category === category) tab.setAttribute('aria-current', 'true'); else tab.removeAttribute('aria-current'); });
      document.querySelector('#result-count')!.textContent = `共 ${count} 篇內容${query ? `・搜尋「${query}」` : ''}`;
      document.querySelector<HTMLElement>('#empty-state')!.hidden = count !== 0;
    }
    function navigate(params: URLSearchParams) {
      history.pushState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
      applyFilters();
    }
    tabs.forEach(tab => tab.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const params = new URLSearchParams(location.search);
      if (tab.dataset.category) params.set('category', tab.dataset.category); else params.delete('category');
      navigate(params);
    }));
    document.querySelector('.search-form')!.addEventListener('submit', event => {
      event.preventDefault();
      const params = new URLSearchParams(location.search);
      if (search.value.trim()) params.set('q', search.value.trim().slice(0, 100)); else params.delete('q');
      navigate(params);
    });
    document.querySelector('#clear-filters')!.addEventListener('click', event => { event.preventDefault(); navigate(new URLSearchParams()); });
    window.addEventListener('popstate', applyFilters);
    applyFilters();
  </script>
</Layout>
<style>.article-item[hidden],.empty-state[hidden]{display:none}</style>
