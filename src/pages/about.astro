---
import { withBase } from '../lib/paths.mjs';
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/content.mjs';
const s = getSettings();
---
<Layout title="關於機房"><header class="page-intro wrap"><a class="back-link" href={withBase('/')}>首頁</a><h1>關於機房</h1><p>中央大學電機與通訊系的學生網管團隊。</p></header><div class="page-content wrap content-grid"><div class="prose"><h2>從校園出發</h2><p>{s.aboutText}</p><h2>日常的技術，真實的責任</h2><p>從網路設備、IP 管理、系館無線網路，到 DNS、Google Workspace 與網頁服務，團隊共同維護師生每天使用的基礎設施。</p><p>我們與學校電算中心協作，監察異常連線、維護系館資安，也把經驗透過培訓傳承給下一屆成員。</p><p><a href={withBase("/joinus")}>認識網管培訓與招募方式</a></p><img src={withBase("/images/placeholder.svg")} alt="機房照片待補" width="1024" height="683" loading="lazy" /></div><aside class="contact-box"><h2>找到我們</h2><p>國立中央大學<br />工程二館 E1-213 室</p><p>{s.officeHours}<br />{s.phone}</p><p><a href={`mailto:${s.email}`}>{s.email}</a></p><a class="text-link" href="https://maps.app.goo.gl/yUiPDJRYHmtqZB7z8" target="_blank" rel="noopener noreferrer">開啟地圖 ↗</a><p style="margin-top:20px"><a href={withBase("/sched")}>查看值班表</a>　<a href={withBase("/members")}>團隊成員</a></p></aside></div></Layout>
