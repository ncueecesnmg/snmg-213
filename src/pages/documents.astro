---
import { withBase } from '../lib/paths.mjs';
import Layout from '../layouts/Layout.astro';
import { documents } from '../lib/seed.mjs';
import { getSettings } from '../lib/content.mjs';
const s = getSettings();
// Downloadable guides are grouped by service; tutorial articles stay in announcements.
const topics = [
  { id: 'wifi', tag: 'Wi-Fi', title: '無線網路', text: '工程二館的 NCU-EECE-802.1x、eduroam、NCU-EECE 與訪客網路連線方式。', help: '/forms/#network', icon: 'M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h.01' },
  { id: 'mail', tag: '郵件', title: '系所郵件', text: 'EE / CE Mail（Google Workspace）的帳號設定、外部收發信軟體與郵件轉移。', help: '/forms/#mail', icon: 'M3 6h18v12H3zM3 7l9 6 9-6' },
].map(topic => ({ ...topic, files: documents.filter(doc => doc.tag === topic.tag) }));
---
<Layout title="文件下載">
  <header class="page-intro wrap"><a class="back-link" href={withBase('/')}>首頁</a><h1>文件下載</h1><p>依主題下載無線網路與系所郵件操作文件，教學文章請至<a class="text-link" href={withBase('/tutorials/')}>教學文章專區</a>閱讀。</p></header>
  <div class="page-content wrap">
    <nav class="filter-tabs doc-jump" aria-label="文件主題">{topics.map(topic => <a href={`#${topic.id}`}>{topic.title}<span>{topic.files.length}</span></a>)}</nav>
    {topics.map(topic => (
      <section class="doc-topic" id={topic.id} aria-labelledby={`${topic.id}-title`}>
        <header class="doc-topic-head">
          <span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><path d={topic.icon} /></svg></span>
          <div><h2 id={`${topic.id}-title`}>{topic.title}</h2><p>{topic.text}</p></div>
        </header>
        <h3 class="doc-label">下載文件</h3>
        {topic.files.map(doc => <a class="doc-file" href={doc.url} target="_blank" rel="noopener noreferrer"><span class="doc-type">文件</span><span><strong>{doc.title}</strong><small>{doc.summary}</small><small class="doc-source">下載文件 · Google 雲端硬碟 · 另開新視窗</small></span><i aria-hidden="true">↓</i></a>)}
        <a class="text-link doc-help" href={withBase(topic.help)}>照著做仍無法使用？回報問題</a>
      </section>
    ))}
    <div class="schedule-help"><p>找不到需要的文件？請來信 {s.email} 詢問。</p></div>
  </div>
</Layout>
