---
import { withBase } from '../lib/paths.mjs';
import Layout from '../layouts/Layout.astro';
import { getMembers } from '../lib/content.mjs';
const members=getMembers();
const groups=[{title:'指導老師',people:members.filter(p=>p.slug==='0-prof')},{title:'機房成員',people:members.filter(p=>p.slug!=='0-prof'&&!p.slug.startsWith('9'))},{title:'歷屆成員',people:members.filter(p=>p.slug.startsWith('9'))}];
---
<Layout title="團隊成員"><header class="page-intro wrap"><a class="back-link" href={withBase('/')}>首頁</a><h1>團隊成員</h1><p>指導老師、現任機房成員與歷屆成員。</p></header><div class="page-content wrap"><form class="member-search" role="search"><label for="member-query">找一位成員</label><input type="search" id="member-query" placeholder="搜尋姓名、年級或加入年份" /><span id="member-count" role="status">{members.length} 位成員</span></form>{groups.map(group=><section class="member-group"><h2>{group.title}</h2><div class="member-grid">{group.people.map((person)=><a class="member-card" href={withBase(`/members/${person.slug}/`)} data-member-search={`${person.name} ${person.attributes}`.toLowerCase()}><div class="member-image">{person.image?<img src={withBase(person.image)} alt={`${person.name}的照片`} width="240" height="240" loading="lazy" />:<span aria-hidden="true">{person.name.slice(0,1)}</span>}</div><div class="member-card-text"><h3>{person.name}</h3><p>{person.attributes||'工程二館網路機房'}</p><span aria-hidden="true">↗</span></div></a>)}</div></section>)}</div><script>const query=document.querySelector<HTMLInputElement>('#member-query')!;const cards=[...document.querySelectorAll<HTMLElement>('[data-member-search]')];document.querySelector('.member-search')!.addEventListener('submit',event=>event.preventDefault());query.addEventListener('input',()=>{let count=0;cards.forEach(card=>{card.hidden=!(card.dataset.memberSearch||'').includes(query.value.trim().toLowerCase());if(!card.hidden)count++});document.querySelector('#member-count')!.textContent=`${count} 位成員`;document.querySelectorAll<HTMLElement>('.member-group').forEach(group=>{group.hidden=![...group.querySelectorAll<HTMLElement>('.member-card')].some(card=>!card.hidden)})});</script></Layout>
