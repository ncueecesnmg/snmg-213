---
import { withBase } from '../../lib/paths.mjs';
import Layout from '../../layouts/Layout.astro';
import { getPosts, renderMarkdown, formatDate, taxonomySlug } from '../../lib/content.mjs';
import { articleHeadings } from '../../lib/markdown.mjs';
export function getStaticPaths() { return getPosts().map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const isTutorial = post.category === '教學文件';
const html=renderMarkdown(post.body.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>/, ''));
const headings=articleHeadings(html);
const minutes=Math.max(1,Math.ceil(html.replace(/<[^>]*>/g,'').replace(/\s+/g,'').length/450));
const posts=getPosts(),position=posts.findIndex(item=>item.slug===post.slug),next=posts[(position+1)%posts.length];
---
<Layout title={post.title} description={post.summary}>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="page-intro wrap"><a class="back-link" href={withBase(isTutorial ? '/tutorials/' : '/announcements/')}>← {isTutorial ? '教學文章' : '最新公告'}</a><h1 class="article-title">{post.title}</h1><p>{post.summary}</p></header>
  <article class="page-content wrap article-layout">
    <aside class="article-sidebar"><div><strong>{post.category}</strong>{post.pinned?'置頂文章':`約 ${minutes} 分鐘閱讀`}</div><div><strong>發布日期</strong><time datetime={post.date}>{formatDate(post.date)}</time></div>{post.author&&<div><strong>作者</strong><a class="text-link" href={withBase(post.author)}>{post.authorName||'機房成員'} ↗</a></div>}{headings.length>0&&<nav class="article-toc" aria-label="文章目錄"><strong>這篇文章</strong>{headings.map(heading=><a href={`#${heading.id}`} class:list={{nested:heading.depth===3}} set:html={heading.title}></a>)}</nav>}</aside>
    <div class="article-body"><div class="prose" set:html={html}></div>{post.tags?.length&&<nav class="article-tags" aria-label="文章標籤">{post.tags.map(tag=><a href={withBase(`/tags/${taxonomySlug(tag)}/`)}>#{tag}</a>)}</nav>}{next&&next.slug!==post.slug&&<a class="next-article" href={withBase(`/announcements/${next.slug}/`)}><span>繼續閱讀</span><h2>{next.title}</h2><span aria-hidden="true">↗</span></a>}</div>
  </article>
</Layout>

