---
import { withBase } from '../lib/paths.mjs';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { getSettings } from '../lib/content.mjs';
interface Props { title?: string; description?: string; }
const { title, description = '國立中央大學工程二館網路機房。網路維運、DNS 申請、系所郵件、網頁代管與網管培訓。' } = Astro.props;
const settings = getSettings();
const path = Astro.url.pathname;
const navigation = [{ href: '/forms/', label: '服務申請' }, { href: '/announcements/', label: '最新公告' }, { href: '/documents/', label: '文件教學' }, { href: '/sched/', label: '值班表' }, { href: '/members/', label: '團隊成員' }];
const resources = [{ href: '/about/', label: '關於機房' }, { href: '/joinus/', label: '培訓與招募' }, { href: '/categories/', label: '內容分類' }, { href: '/pages/', label: '網站索引' }];
const canonical = new URL(path, Astro.site);
const siteName = '中央大學工程二館網路機房 SNMG';
const ticker = ['SNMG E1-213', '網路維運', 'DNS 管理', '系所郵件', '網頁代管', '網管培訓招募中', settings.officeHours];
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <slot name="head" />
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta property="og:title" content={title || siteName} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="zh_TW" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/images/social.svg'), Astro.site)} />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('js-motion')</script>
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <div class="ticker"><p class="led" data-led={ticker.map(item => `${item}　·　`).join('')} data-led-rows="14" data-led-speed="18">{ticker.join('、')}</p></div>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase("/")} aria-label="工程二館網路機房首頁"><Mark /></a>
        <nav class="desktop-nav" aria-label="主要導覽">{navigation.map(link => <a href={withBase(link.href)} aria-current={path === withBase(link.href) ? 'page' : undefined}>{link.label}</a>)}<details class="resource-menu"><summary>關於我們 <span aria-hidden="true">＋</span></summary><nav aria-label="關於我們">{resources.map(link => <a href={withBase(link.href)}>{link.label}</a>)}</nav></details><i class="nav-dot" aria-hidden="true"></i></nav>
        <a class="header-action" href={withBase("/forms/#network")}>網路問題回報</a>
        <details class="mobile-menu"><summary aria-label="開啟導覽選單"><span class="burger" aria-hidden="true"><i></i><i></i></span>選單</summary><nav aria-label="手機導覽">{navigation.map(link => <a href={withBase(link.href)}>{link.label}</a>)}{resources.map(link => <a href={withBase(link.href)}>{link.label}</a>)}<a href={withBase("/forms/#network")}>網路問題回報</a></nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-unit">
        <div class="footer-brand">
          <a href={withBase("/")} class="brand" aria-label="工程二館網路機房首頁"><Mark /></a>
          <p>國立中央大學 工程二館 E1-213 室<br />{settings.officeHours}<br />{settings.phone}<br /><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
        </div>
        <nav aria-label="服務"><h2>服務</h2><a href={withBase("/forms/#network")}>網路異常回報</a><a href={withBase("/forms/#dns")}>DNS 網域申請</a><a href={withBase("/forms/#mail")}>郵件服務協助</a><a href={withBase("/forms/#hosting")}>網頁代管</a></nav>
        <nav aria-label="資訊"><h2>資訊</h2><a href={withBase("/announcements/")}>最新公告</a><a href={withBase("/documents/")}>文件教學</a><a href={withBase("/sched/")}>值班表</a><a href={withBase("/about/")}>關於機房</a><a href={withBase("/joinus/")}>培訓與招募</a></nav>
        <nav aria-label="相關連結"><h2>相關連結</h2><a href="https://www.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">國立中央大學 ↗</a><a href="https://www.cc.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">中央大學電算中心 ↗</a><a href="https://www2.ee.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">電機工程學系 ↗</a><a href="https://www.ce.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">通訊工程學系 ↗</a><a href="https://maps.app.goo.gl/yUiPDJRYHmtqZB7z8" target="_blank" rel="noopener noreferrer">機房位置地圖 ↗</a></nav>
      </div>
      <div class="wrap footer-panel" aria-hidden="true"><span>E1-213</span><div class="ports">{Array.from({ length: 24 }, () => <i></i>)}</div><span>SNMG</span></div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} NCU EECE SNMG 工程二館網路機房</span><span><a href={withBase('/privacy-policy/')}>隱私權說明</a>　<a href={withBase('/admin/')}>管理後台</a>　<a href={withBase('/pages/')}>網站索引</a>　<a href="#main">回到頂端 ↑</a></span></div>
    </footer>
    <script>import '../scripts/site.ts'; import '../scripts/led.ts';</script>
  </body>
</html>
